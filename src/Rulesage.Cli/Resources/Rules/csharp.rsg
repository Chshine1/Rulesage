domain csharp

@"A semicolon ';' marking statement ending."
concept semicolon-separator

@"A using directive, e.g., 'using System;' or 'using Math = System.Math;'."
concept using-directive with
  namespace(literal),
  aliasName(literal)                  // empty if not alias

@"Complete class/struct/record/interface header, including generics and constraints."
+"Generates e.g.: 'public sealed class MyClass<T> : Base, IInterface where T : class'"
concept class-header with
  className(literal),                 // must be PascalCase
  kind(literal),                      // "class" | "struct" | "record" | "interface"
  modifiers(literal[]),               // e.g., ["public", "partial"]
  baseClass(literal),                 // may be empty
  implementedInterfaces(literal[]),
  genericParameters(generic-parameter-definition[])  // empty if none

@"A single generic type parameter with its constraints.
Used inside class-header or method-signature."
concept generic-parameter-definition with
  name(literal),                      // e.g., "T"
  constraints(literal[])              // e.g., ["class", "new()", "IComparable"]

@"Method signature without body. Generates e.g.: 'private Task<T> GetAsync<T>(string key) where T : class'"
concept method-signature with
  methodName(literal),                // must be PascalCase
  returnType(literal),                // textual type, e.g., "Task<int>"
  modifiers(literal[]),               // e.g., ["public", "static", "async"]
  parameters(parameter-definition[]),
  genericParameters(generic-parameter-definition[])
  
@"The content of a class/struct/record body as a braced block."
concept class-body with
  content(literal)                    // the complete method body content without braces

@"Method body as a braced block."
concept method-body with
  content(literal)                    // the complete method body content without braces

@"A single parameter declaration, e.g., 'int count' or 'params string[] args'."
concept parameter-definition with
  name(literal),
  type(literal),
  isParams(literal),                  // "true" | "false"
  defaultValue(literal)               // may be empty

@"Full property declaration, e.g., 'public string Name { get; set; }'"
concept property-declaration with
  propertyName(literal),
  propertyType(literal),
  modifiers(literal[]),
  getterAccess(literal),              // "", "private", "internal" etc.
  setterAccess(literal)

@"Field declaration, e.g., 'private readonly int _count;'"
concept field-declaration with
  fieldName(literal),
  fieldType(literal),
  modifiers(literal[]),
  isReadonly(literal),
  initializer(literal)                // "42" or empty

@"Event declaration, e.g., 'public event EventHandler Click;'"
concept event-declaration with
  eventName(literal),
  handlerType(literal),
  modifiers(literal[])

@"Attribute usage, e.g., '[Obsolete(\"reason\")]'"
concept attribute-usage with
  attributeType(literal),             // usage name like "Obsolete" without "Attribute" suffix
  constructorArguments(literal[]),    // literal representations
  namedProperties(tuple<literal,literal>[])  // (name, value)

@"Constraints on a general interface name"
rule interface-name-constraints given:
constraints: [
  "Interface name must begin with uppercase 'I' and follow PascalCase (e.g., 'IReadable')."
]

@"Provides constraints for general asynchronous method signatures."
rule async-method-constraints given:
constraints: [
  "Async method name must end with 'Async'.",
  "Async method should include a CancellationToken parameter named 'cancellationToken' with default value 'default', placed as the last parameter."
]

@"Provides naming constraints for general generic type parameters"
rule generic-parameter-naming-constraints given:
constraints: [
  "For a single unconstrained parameter, use 'T' as the name; or for a specific role: use T<Role> as the name, e.g. TKey, TValue, TResult."
]

@"Resources in a class that need disposing, categories: managed resources, unmanaged resources or async disposable resources."
concept disposable-resources with
  managed(literal), unmanaged(literal), async(literal)

@"Constraints on a class for disposable patterns. Each constraint specifies one member (field or method), combining its signature and core behavior in a single sentence."
rule disposable-pattern-constraints for classDescription(literal) given:
  resources:
    ref(disposable-resources)
        "The disposable resources from this class description: \"{$classDescription}\"."
       +"\nDescribe each present resource in natural language, do not infer determined fields if not explicitly given. Use 'none' if a category has no resources."
  anyResource:
    if $resources.managed is "none" and $resources.unmanaged is "none" and $resources.async is "none" then
      then "false"
      else "true"
  needIDisposable:
    if $resources.managed is not "none" or $resources.unmanaged is not "none" then [
      "Need to implement IDisposable.",
      "Has a public void Dispose() method implementing IDisposable, which calls Dispose(true) and GC.SuppressFinalize(this)"
    ]
    else []
  needIAsyncDisposable:
    if $resources.async is not "none" then [
      "Need to implement IAsyncDisposable.",
      "Has a public async ValueTask DisposeAsync() method implementing IAsyncDisposable, which calls await DisposeAsyncCore() and GC.SuppressFinalize(this)."
    ]
    else []
  disposeMethodConstraint:
    if $resources.managed is not "none" or $resources.unmanaged is not "none" then
      ref(literal[])
          "Write one sentence (one array element) describing the need of a Dispose(bool disposing) method."
         +"\nManaged resources: {$resources.managed}. Unmanaged resources: {$resources.unmanaged}."
         +"\nThe sentence must state the full signature (protected virtual void) and that when disposing is true, it disposes the managed resources, then disposes unmanagedd resources and sets _disposed = true."
         +"\nIf the class is sealed and has only managed resources, the method can be private and non‑virtual."
         +"\nIt should be 'Needs a method <signature> with contents <contents>'"
    else []
  disposeAsyncCoreConstraint:
    if $resources.async is not "none" then
      ref(literal[])
          "Write one sentence (one array element) describing the need of a DisposeAsyncCore() method."
         +"\nAsync resources: {$resources.async}."
         +"\nThe sentence must state the full signature (protected virtual async ValueTask DisposeAsyncCore()) and that it should asynchronously dispose the given resources (e.g., await _client.DisposeAsync()), then set _disposed = true."
         +"\nIt should be 'Needs a method <signature> with contents <contents>'"
    else []
  fixedConstraints: [
    "Need a field: private bool _disposed; to track disposal state."
  ]
  constraints:
    if $anyResource then
      result of concat-arrays where arrays = [
        $fixedConstraints,
        $needIDisposable, $needIAsyncDisposable,
        $disposeMethodConstraint, $disposeAsyncCoreConstraint
      ]
    else []

@"Assembles a complete class/struct/record/interface declaration as a literal string, from a semantic description."
rule compose-class-declaration for description(literal) given:
needsBody:
  ref(literal)
      "If there is a body for a type declaration described by: \"{$description}\". Answer strictly 'true' or 'false'."
     +"\nA body is required if it contains any members (methods, properties, fields, constants, nested types, etc.)."
signature:
  ref(literal)
      "The complete signature line (class/struct/record/interface header) for: \"{$description}\"."
     +"\nInclude all modifiers, name, generic parameters, base class, and interfaces."
     +"\nReturn only the signature line, without body or semicolon."
body:
  if $needsBody is "true" then
    ref(literal)
        "The body content (without outer braces) for the type described as: \"{$description}\"."
       +"\nInclude all members: fields, methods, properties, nested types, etc."
       +"\nReturn only the body content, no outer braces."
  else
    ""
completeClass:
  if $needsBody is "true" then
    result of concat-string where strings = [
      $signature, "\n{\n", $body, "\n}"
    ]
  else
    result of concat-string where strings = [
      $signature, ";"
    ]

@"Assembles a complete method declaration as the full literal string, from a semantic description."
rule compose-method-declaration for description(literal) given:
needsBody:
  ref(literal) in none
      "If there is a body for the method described by: \"{$description}\". Answer strictly 'true' or 'false'."
     +"\nFor example, it must NOT have a body if it is abstract, an interface member without default implementation."
signature:
  ref(literal) in none
      "Generate the full method signature (without body) for: \"{$description}\"."
     +"\nInclude modifiers, return type, method name, parameters, and any generic type constraints."
     +"\nReturn only the signature line."
body:
  if $needsBody is "true" then
    ref(literal) in none
        "Generate the body content (without outer braces) for the method described as: \"{$description}\"."
       +"\nThe body should implement the described behavior. If no specific behavior is given, provide a minimal sensible implementation."
       +"\nReturn only the body content."
  else
    ""
completeMethod:
  if $needsBody is "true" then
    result of concat-string where strings = [
      $signature, "\n{\n", $body, "\n}"
    ]
  else
    result of concat-string where strings = [
      $signature, ";"
    ]
