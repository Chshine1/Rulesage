domain csharp

#leaf
@"A semicolon ';' marking statement ending."
concept semicolon-separator

#leaf
@"A using directive, e.g., 'using System;' or 'using Math = System.Math;'."
concept using-directive with
  namespace(literal),
  aliasName(literal)                  // empty if not alias

#leaf
@"Complete class/struct/record/interface header, including generics and constraints."
+"Generates e.g.: 'public sealed class MyClass<T> : Base, IInterface where T : class'"
concept class-header with
  className(literal),                 // must be PascalCase
  kind(literal),                      // "class" | "struct" | "record" | "interface"
  modifiers(literal[]),               // e.g., ["public", "partial"]
  baseClass(literal),                 // may be empty
  implementedInterfaces(literal[]),
  genericParameters(generic-parameter-definition[])  // empty if none

#leaf
@"A single generic type parameter with its constraints.
Used inside class-header or method-signature."
concept generic-parameter-definition with
  name(literal),                      // e.g., "T"
  constraints(literal[])              // e.g., ["class", "new()", "IComparable"]

#leaf
@"Method signature without body. Generates e.g.: 'private Task<T> GetAsync<T>(string key) where T : class'"
concept method-signature with
  methodName(literal),                // must be PascalCase
  returnType(literal),                // textual type, e.g., "Task<int>"
  modifiers(literal[]),               // e.g., ["public", "static", "async"]
  parameters(parameter-definition[]),
  genericParameters(generic-parameter-definition[])

#leaf
@"Method body as a braced block."
concept method-body with
  content(literal)                    // the complete method body content without braces

#leaf
@"A single parameter declaration, e.g., 'int count' or 'params string[] args'."
concept parameter-definition with
  name(literal),
  type(literal),
  isParams(literal),                  // "true" | "false"
  defaultValue(literal)               // may be empty

#leaf
@"Full property declaration, e.g., 'public string Name { get; set; }'"
concept property-declaration with
  propertyName(literal),
  propertyType(literal),
  modifiers(literal[]),
  getterAccess(literal),              // "", "private", "internal" etc.
  setterAccess(literal)

#leaf
@"Field declaration, e.g., 'private readonly int _count;'"
concept field-declaration with
  fieldName(literal),
  fieldType(literal),
  modifiers(literal[]),
  isReadonly(literal),
  initializer(literal)                // "42" or empty

#leaf
@"Event declaration, e.g., 'public event EventHandler Click;'"
concept event-declaration with
  eventName(literal),
  handlerType(literal),
  modifiers(literal[])

#leaf
@"Attribute usage, e.g., '[Obsolete(\"reason\")]'"
concept attribute-usage with
  attributeType(literal),             // usage name like "Obsolete" without "Attribute" suffix
  constructorArguments(literal[]),    // literal representations
  namedProperties(tuple<literal,literal>[])  // (name, value)

@"Suggests a conventional type parameter name based on the role described."
rule generic-parameter-naming for roleDescription(literal)
must be:
  ref(literal)
      "A conventional generic type parameter name, given the role description \"{$roleDescription}\"."
     +"\nUse 'T' for a single, unconstrained parameter, or 'T<Role>' for a parameter of specific role/meaning."
     +"\nFor example: 'TResult' for a return value; 'TKey', 'TValue' for dictionaries; 'TElement' for collections; etc."

@"Detects if a class needs to implement IDisposable based on owned resources, and if so, get the standard Dispose pattern signatures."
rule disposable-pattern-required for classDescription(literal)
given:
  needsDispose:
    ref(literal)
        "Whether the class described by \"{$classDescription}\" own any disposable resources"
       +" (e.g., streams, connections, unmanaged handles). Return 'true' or 'false'."
  neededBranch:
    record tuple<literal, method-signature[]> with
      val1 = "true",
      val2 = 
        ref(method-signature[])
            "The standard method signatures for the IDisposable pattern:"
           +"\n- public void Dispose()"
           +"\n- protected virtual void Dispose(bool disposing)"
           +"\nReturn them as an array of method-signature records with appropriate modifiers."
  notNeededBranch:
    record tuple<literal, method-signature[]> with val1 = "false", val2 = []
  disposalMethods:
    result of find-in-dictionary on
      key = $needsDispose,
      dictionary = [$neededBranch, $notNeededBranch]
  result:
    record tuple<literal, method-signature[]> with
      val1 = $needsDispose, val2 = $disposalMethods

---

@"Generates a valid C# interface name from a base concept description."
rule derive-interface-name for baseConcept(literal)
must be:
  ref(literal)
      "A suitable C# interface name, given the concept description \"{$for.baseConcept}\". "
     +"The interface name must begin with uppercase 'I' and follow PascalCase (e.g., 'IReadable')."

@"Adjusts a method signature to conform to async conventions:
- Method name must end with 'Async'.
- If the return type is Task/Task<T> and the method is not an event handler,
  it should accept a CancellationToken parameter with a default value of default."
rule async-method-conventions
   for original(method-signature), isEventHandler(literal) // "true"/"false"
given:
  adjustedName:
    ref(literal) in none
        "If method name \"{$for.original.methodName}\" does not already end with 'Async',"
       +" return the name with 'Async' appended (preserve PascalCase). Otherwise return it unchanged."
  needsCancellation:
    ref(literal) in none
        "Given return type \"{$for.original.returnType}\" and isEventHandler={$for.isEventHandler},"
       +" return 'true' if the method should accept a CancellationToken parameter (return type is Task or Task<T> and it is not an event handler)."
       +" Otherwise return 'false'."
  enhancedParams:
    if $given.needsCancellation = "true"
    then seq append to $for.original.parameters with
           parameter-definition{ name="cancellationToken", type="CancellationToken", isParams="false", defaultValue="default" }
    else $for.original.parameters
must be:
  ref(method-signature) in none
      "Create a method-signature where methodName = \"{$given.adjustedName}\","
     +" returnType = \"{$for.original.returnType}\","
     +" modifiers = {$for.original.modifiers},"
     +" parameters = {$given.enhancedParams},"
     +" genericParameters = {$for.original.genericParameters}."

@"Determines whether a member or type declaration with an empty body should
be terminated by a semicolon or an empty brace block, according to C# rules:
- Abstract methods, interface members, and partial method declarations → semicolon.
- Non‑abstract class/struct methods → empty braces (enforced by the language).
- For records / class / struct definitions: an empty body may be written with
  braces; a record with a primary constructor can also end with a semicolon.
Returns either 'semicolon' or 'braced-content'."
rule resolve-body-terminator
   for memberKind(literal),     // "method" | "property" | "class" | "record" | "interface" ...
       isAbstract(literal),     // "true"/"false"
       hasDefaultImpl(literal), // "true"/"false" for interface members with default implementation
       isPartial(literal)       // "true"/"false"
must be:
  ref(literal) in none
      "Given memberKind={$for.memberKind}, isAbstract={$for.isAbstract},"
     +" hasDefaultImpl={$for.hasDefaultImpl}, isPartial={$for.isPartial}."
     +" Return 'semicolon' if the empty body should be terminated by a semicolon (;)."
     +" Return 'braced-content' if it must use an empty braced block { }."
     +" Follow standard C#: abstract/interface/partial without body → 'semicolon';"
     +" class/struct with empty body → 'braced-content'; records can use either, prefer 'semicolon' when possible."

@"Advises whether a given contract should be modelled as an abstract class or
an interface. Takes a natural description of the shared characteristics.
Returns a pair: (kind, baseType) where kind is 'class' (abstract) or 'interface',
and baseType is an optional existing type name that might influence the decision."
rule choose-abstraction-form
   for description(literal), existingBaseType(literal) // may be empty
given:
  decision:
    ref(record Tuple<literal, literal>) in none
        "Given the description \"{$for.description}\" and existingBaseType \"{$for.existingBaseType}\","
       +" return a pair: (kind, suggestedName)."
       +" kind must be either 'class' (meaning abstract class) or 'interface'."
       +" If existingBaseType is not empty, kind must be 'class' because a type can only inherit one base class."
       +" Otherwise, prefer 'interface' for pure capability contracts (e.g., -able, -ible),"
       +" and 'class' when shared implementation, common state, or an is-a relationship is described."
       +" suggestedName is a recommended name for the abstraction (e.g., 'MyServiceBase' for a class, 'IMyService' for an interface)."
must be:
  ref(record Tuple<literal, literal>) in none
      "Return the pair (kind, suggestedName) from the decision: {$given.decision}."

@"Converts a proposed field name into the standard private instance field naming
convention: _camelCase. (Static private fields may additionally use s_ prefix.)"
rule normalize-private-field-name
   for rawName(literal), isStatic(literal) // "true"/"false"
must be:
  ref(literal) in none
      "Given rawName=\"{$for.rawName}\" and isStatic={$for.isStatic},"
     +" return the correctly cased field name following .NET conventions:"
     +" if isStatic='true', prefix with 's_', else prefix with '_'."
     +" Then ensure the remaining part starts with a lowercase letter (camelCase)."
     +" For example, 'Count' → '_count', 'IsReady' → '_isReady', static 'Cache' → 's_cache'."

@"Determines the appropriate setter accessibility for a property based on
immutability intent and external visibility."
rule property-setter-accessibility
   for propertyName(literal), isReadOnly(literal),    // "true"/"false" – intended immutability
       isCollection(literal),                         // "true"/"false"
       requiredExternalModification(literal)          // "true"/"false"
must be:
  ref(tuple<literal,literal>) in none   // (getterAccess, setterAccess)
      "For a property named \"{$for.propertyName}\":"
     +" isReadOnly={$for.isReadOnly}, isCollection={$for.isCollection},"
     +" requiredExternalModification={$for.requiredExternalModification}."
     +" Return a pair (getterAccessibility, setterAccessibility)."
     +" If isReadOnly='true' and not a collection, prefer an init-only setter or private set."
     +" Use init-only when the value is set once during object construction."
     +" If it is a read-only collection, use a getter that returns an IReadOnlyCollection etc."
     +" If external modification is allowed, setter should be public; otherwise private or internal."
     +" getter is typically public; setter can be 'private', 'init', 'internal', or empty string (for public)."
     +" Values must be valid C# accessor modifiers."

@"Given a data-holding concept description, returns guidelines encoded as a set of modifier/type choices to favour immutability."
rule immutability-guidance for dataDescription(literal)
must be:
  ref(tuple<literal[], literal[]>)
      "Based on the description \"{$dataDescription}\", return two lists:"
     +" (recommendedModifiers, recommendedFeatures)."
     +" recommendedModifiers are modifiers to apply to the type, e.g., ['sealed'] for a class that should not be inherited,"
     +" or ['readonly'] for a struct."
     +" recommendedFeatures are strings from: 'init-only-properties', 'readonly-fields', 'primary-constructor',"
     +" 'with-expressions', 'IReadOnlyCollection', 'System.Collections.Immutable'."
     +" Favour init-only setters and readonly fields for data that should not change after construction."
