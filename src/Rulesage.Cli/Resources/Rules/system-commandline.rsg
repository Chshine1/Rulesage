domain system-commandline

@"Root command of System.CommandLine, inherits from Command."
concept root-command
  name(literal), description(literal), options(record cli-option[])

@"Option definition in System.CommandLine, typically Option<T>."
concept cli-option
  name(literal), alias(literal), argumentType(literal), description(literal)

@"A class/delegate that implements ICommandHandler or directly binds a method."
concept command-handler
  className(literal), namespace(literal), executeMethod(record clr-method)
