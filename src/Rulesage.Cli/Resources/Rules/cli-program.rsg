domain cli-program

@"standard readable input stream"
concept stdin with handle(literal)

@"Standard output stream, write-only byte stream."
concept stdout with handle(literal)

@"Standard error stream, write-only byte stream."
concept stderr with handle(literal)

@"A CLI program with three standard streams and an executable name."
concept cli-program with
  name(literal), stdin(stdin), stdout(stdout), stderr(stderr)
