domain clr

@"A CLR type: class, struct, interface, enum, delegate, or generic instantiation."
concept clr-type
  fullName(literal),          // e.g., "System.Collections.Generic.List`1"
  namespace(literal),
  name(literal),
  kind(literal),              // "class" | "struct" | "interface" | "enum" | "delegate"
  genericParameters(clr-generic-parameter[]),
  isSealed(literal),          // "true" | "false"
  isAbstract(literal)

@"A generic type parameter of a CLR type or method."
concept clr-generic-parameter
  name(literal),
  constraintTypes(clr-type[]) // empty if no constraint

@"A method on a CLR type."
concept clr-method
  name(literal),
  declaringType(clr-type),
  parameterTypes(clr-type[]),
  returnType(clr-type),
  isStatic(literal),
  isAbstract(literal),
  isVirtual(literal)

@"A property on a CLR type."
concept clr-property
  name(literal),
  declaringType(clr-type),
  propertyType(clr-type),
  canRead(literal),
  canWrite(literal)

@"A field on a CLR type."
concept clr-field
  name(literal),
  declaringType(clr-type),
  fieldType(clr-type),
  isStatic(literal),
  isReadonly(literal)

@"An event on a CLR type."
concept clr-event
  name(literal),
  declaringType(clr-type),
  handlerType(clr-type)

@"A custom attribute attached to any CLR member."
concept clr-attribute
  attributeType(clr-type),
  constructorArguments(literal[]),
  namedProperties(tuple<literal,literal>[])  // (propName, value)
