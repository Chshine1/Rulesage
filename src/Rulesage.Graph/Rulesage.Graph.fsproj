<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="GraphConfig.fs" />
        <Compile Include="Services\Abstractions\IStructureBuilder.fs" />
        <Compile Include="Services\Abstractions\IDescriptionCleaner.fs" />
        <Compile Include="Services\Abstractions\ISemanticGraphBuilder.fs" />
        <Compile Include="Services\Abstractions\IGraphFuser.fs" />
        <Compile Include="Services\Abstractions\ILabelProagator.fs" />
        <Compile Include="Services\Implementations\StructureBuilder.fs" />
        <Compile Include="Services\Implementations\DescriptionCleaner.fs" />
        <Compile Include="Services\Implementations\SemanticGraphBuilder.fs" />
        <Compile Include="Services\Implementations\GraphFuser.fs" />
        <Compile Include="Services\Implementations\LabelPropagator.fs" />
        <Compile Include="IGraphBuilder.fs" />
        <Compile Include="GraphBuilder.fs" />
        <Compile Include="Extensions\DependencyInjectionExtensions.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Rulesage.Common\Rulesage.Common.fsproj" />
      <ProjectReference Include="..\Rulesage.Shared\Rulesage.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
      <PackageReference Include="QuikGraph" Version="2.5.0" />
      <PackageReference Include="QuikGraph.Graphviz" Version="2.5.0" />
      <PackageReference Update="FSharp.Core" Version="10.1.300" />
    </ItemGroup>

</Project>
