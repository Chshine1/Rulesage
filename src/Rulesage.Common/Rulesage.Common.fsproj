<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Types\Domain\Primitive.fs" />
        <Compile Include="Types\Domain\BlueprintValue.fs" />
        <Compile Include="Types\Domain\Rule.fs" />
        <Compile Include="Types\Composition\CompositionContext.fs" />
        <Compile Include="Types\Composition\SemanticOperation.fs" />
        <Compile Include="Grammar\Domain\Primitive.fs" />
        <Compile Include="Grammar\ParseContext.fs" />
        <Compile Include="Grammar\AST.fs" />
        <Compile Include="Grammar\Parsers.fs" />
        <Compile Include="Grammar\Domain.fs" />
        <EmbeddedResource Include="Migrations\*.sql" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FParsec" Version="1.1.1" />
      <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
      <PackageReference Update="FSharp.Core" Version="10.1.203" />
      <PackageReference Include="Npgsql" Version="10.0.2" />
    </ItemGroup>

</Project>
