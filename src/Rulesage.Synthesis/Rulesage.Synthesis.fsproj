<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Types\SynthesizedValue.fs" />

        <Compile Include="Services\Abstractions\IActionService.fs" />

        <Compile Include="Services\Abstractions\INodeService.fs" />

        <Compile Include="Services\Abstractions\INlTaskResolver.fs" />

        <Compile Include="Services\Implementations\NlTaskResolver.fs" />

        <Compile Include="Services\Implementations\ActionService.fs" />

        <Compile Include="SynthesisContext.fs" />
      
        <Compile Include="Interpreters\Abstractions\IExprInterpreter.fs" />
      
        <Compile Include="Interpreters\Implementations\VarExprInterpreter.fs" />
      
        <Compile Include="Interpreters\Implementations\StringTemplateInterpreter.fs" />
      
        <Compile Include="Interpreters\Implementations\PrimitiveExprInterpreter.fs" />
      
        <Compile Include="Interpreters\Implementations\Domain\DynamicExprInterpreter.fs" />
      
        <Compile Include="Interpreters\Implementations\Domain\SeqExprInterpreter.fs" />
      
        <Compile Include="Interpreters\Implementations\Domain\ValueExprInterpreter.fs" />
      
        <Compile Include="IRuleSynthesizer.fs" />
      
        <Compile Include="RuleSynthesizer.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Rulesage.Common\Rulesage.Common.fsproj" />
      <ProjectReference Include="..\Rulesage.Composition\Rulesage.Composition.csproj" />
      <ProjectReference Include="..\Rulesage.Retrieval\Rulesage.Retrieval.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.203" />
        <PackageReference Include="MoonSharp" Version="2.0.0" />
    </ItemGroup>

</Project>
